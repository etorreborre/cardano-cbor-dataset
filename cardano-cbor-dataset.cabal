cabal-version: 3.0
name:          cardano-cbor-dataset
version:       0.1.0.0
build-type:    Simple

executable cbor
  main-is:          Main.hs
  hs-source-dirs:   app
  other-modules:
    Corpus
    LedgerRules
    Normalize
    Paths
    Report
  default-language: Haskell2010
  ghc-options:      -Wall -Wcompat
  build-depends:
    aeson,
    base,
    bytestring,
    cardano-crypto-class,
    cardano-data,
    cardano-ledger-allegra,
    cardano-ledger-alonzo,
    cardano-ledger-binary,
    cardano-ledger-conway:{cardano-ledger-conway, testlib},
    cardano-ledger-core:{cardano-ledger-core, testlib},
    cardano-ledger-dijkstra:{cardano-ledger-dijkstra, testlib},
    cardano-protocol,
    cardano-protocol-tpraos:testlib,
    cborg,
    containers,
    directory,
    filepath,
    optparse-applicative,
    process,
    temporary,
    text,
    unix
